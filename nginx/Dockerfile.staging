# Build context is the REPOSITORY ROOT (set in docker-compose.staging.yml),
# because this image needs both ./frontend (the source to build) and ./nginx
# (the config to serve it with). See ../.dockerignore for what is excluded.

# --- build the SPA -----------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

# Manifests first, so `npm ci` stays cached until dependencies change.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# --- serve it ----------------------------------------------------------
FROM nginx:1.27-alpine

# Both variants ship; the entrypoint picks one based on certificate presence.
COPY nginx/conf/http.conf.template /etc/nginx/available/http.conf.template
COPY nginx/conf/tls.conf.template  /etc/nginx/available/tls.conf.template
COPY nginx/conf/app.conf           /etc/nginx/snippets/app.conf

COPY nginx/docker-entrypoint.d/10-select-config.sh /docker-entrypoint.d/10-select-config.sh
RUN chmod +x /docker-entrypoint.d/10-select-config.sh

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 443
# The base image's own CMD starts nginx in the foreground.
