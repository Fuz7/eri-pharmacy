# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored - never commit it.

# --- Postgres container initialisation -------------------------------
# Compose substitutes these into the db service via ${VAR}.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eri_pharmacy

# --- Backend database connection -------------------------------------
# The only variable the application code actually reads.
# Host is "db" (the Compose service name) when running in Docker,
# and "localhost" when running the backend directly on your machine.
POSTGRES_CONNECTION=postgresql://postgres:change-me@db:5432/eri_pharmacy

# Not read by the code; kept for reference and local tooling.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Frontend ---------------------------------------------------------
# Passed into the frontend container. Note: requests actually reach the
# API through the Vite proxy in vite.config.js, not through these.
VITE_BACKEND_URL=http://backend
VITE_BACKEND_PORT=3000
VITE_LOCAL_BACKEND_URL=http://localhost
VITE_LOCAL_BACKEND_PORT=3000
