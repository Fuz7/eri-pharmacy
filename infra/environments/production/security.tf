# Security group for the EC2 instance.

# --- Security group ---

resource "aws_security_group" "app" {
  name        = "${local.name}-sg"
  description = "Allow SSH, HTTP/HTTPS, and app ports"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }


  # NOTE: Postgres (5432) is intentionally NOT opened here.
  # Backend and Postgres containers talk to each other over
  # Docker's internal network on the same EC2 instance —
  # they never need to go through this security group at all.

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${local.name}-sg"
  }
}
