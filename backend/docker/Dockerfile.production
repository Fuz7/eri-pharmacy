# Production image. Currently identical to Dockerfile.staging — kept separate so
# the two can diverge (resource limits, log level, a different base tag) without
# a change to one silently altering the other.
#
# Built by .github/workflows/production.yml with ./backend as the context.

FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY src ./src
# Applied by deploy.sh before the new containers start.
COPY migrations ./migrations

EXPOSE 3000
# Not `npm run start` — that script uses `node --watch`, which is a
# development affordance and restarts the process on any file touch.
CMD ["node", "./src/index.js"]
