FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY src ./src

EXPOSE 3000
# Not `npm run start` — that script uses `node --watch`, which is a
# development affordance and restarts the process on any file touch.
CMD ["node", "./src/index.js"]
